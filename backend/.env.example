PORT=3001

# MongoDB (optional — analyses saved when connected)
MONGODB_URI=mongodb://localhost:27017/impactiq

# TestRail API (https://docs.testrail.com/api-reference/)
TESTRAIL_URL=https://testrail.csod.com
TESTRAIL_USER=your-email@company.com
# mcp-testrail uses TESTRAIL_USERNAME — backend accepts either
TESTRAIL_USERNAME=your-email@company.com
TESTRAIL_API_KEY=your-api-key
TESTRAIL_PROJECT_ID=49

# galaxy-automation repo path
AUTOMATION_REPO_PATH=C:\Users\vrutikpatwa\galaxy-automation
AUTOMATION_ENV=PRESTAGE

# Jira API (Bearer token — Personal Access Token)
JIRA_BASE_URL=https://jira.csod.com
JIRA_API_TOKEN=your-jira-personal-access-token
JIRA_USER=

# Cursor MCP — gap analysis runs in Cursor IDE via MCP (no OpenAI key)
# Optional: CURSOR_API_KEY for programmatic Cursor SDK agents
CURSOR_API_KEY=
CURSOR_MCP_CONFIG=.cursor/mcp.json

# CORS
FRONTEND_URL=http://localhost:5173
